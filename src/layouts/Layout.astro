---
import Menu from '../components/Menu.astro';
import Hero from '../components/Hero.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Hobbies from '../components/Hobbies.astro';
import Cryptography from '../components/Cryptography.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
	<link rel="icon" type="image/x-icon" href="src/assets/logo_danmg_sf.webp" />
    <title>&lt;dan/mg&gt; | Portafolio</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#030305] min-h-screen relative overflow-x-hidden font-sans text-gray-200 selection:bg-cyan-500 selection:text-white">
    
    <Menu />

    <!-- Luces Neón de Fondo Globales -->
    <div class="absolute top-[-10%] left-[-10%] w-[40rem] h-[40rem] bg-cyan-600 rounded-full mix-blend-screen filter blur-[120px] opacity-20 pointer-events-none fixed"></div>
    <div class="absolute bottom-[-20%] right-[-10%] w-[50rem] h-[50rem] bg-purple-700 rounded-full mix-blend-screen filter blur-[150px] opacity-20 pointer-events-none fixed"></div>

    <main class="flex flex-col gap-12 pb-24">
        <Hero />
        <Education />
        <Hobbies />
        <Cryptography />
        <Contact />
    </main>

  </body>
</html>