---
// src/components/Hobbies.astro
import { Image } from 'astro:assets';

// Importamos las imágenes directamente desde src/assets/
import aoRacingImg from '../assets/AORacing.webp';
import simRacingImg from '../assets/simracing.webp';
import bubusImg from '../assets/bubus.webp';
---

<section id="hobbies" class="w-full max-w-5xl mx-auto py-16 px-6 relative z-10">
    <!-- Título de la sección -->
    <div class="flex items-center gap-4 mb-10 border-l-4 border-cyan-500 pl-4">
        <h3 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-500 drop-shadow-[0_0_8px_rgba(34,211,238,0.5)]">
            Mis Hobbies
        </h3>
        <div class="h-[1px] flex-grow bg-gradient-to-r from-cyan-500/50 to-transparent"></div>
    </div>

    <!-- Contenedor principal del Carrusel con overflow oculto -->
    <div class="relative w-full overflow-hidden rounded-2xl padding-4">
        
        <!-- Pista que se moverá con GSAP -->
        <div id="hobbies-track" class="flex gap-6 w-max cursor-grab active:cursor-grabbing">
            
            <!-- Tarjeta 1: Motorsports -->
            <div class="hobby-card w-[300px] sm:w-[350px] flex-shrink-0 bg-[#0a0a10]/60 backdrop-blur-xl border border-cyan-500/30 shadow-[0_0_15px_rgba(0,150,255,0.1)] rounded-2xl p-5 group flex flex-col">
                <div class="w-full h-48 rounded-xl overflow-hidden relative border border-white/10 mb-4">
                    <Image src={aoRacingImg} alt="Motorsports" class="w-full h-full object-cover group-hover:scale-110 group-hover:rotate-1 transition-all duration-500" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                </div>
                <h4 class="text-xl font-bold text-cyan-400 mb-2">Motorsports</h4>
                <p class="text-gray-400 text-sm leading-relaxed">
                    Disfruto ver carreras de autos, especialmente WEC, GTWC y F1. Me encanta analizar estrategias de carrera, setups de autos y la física detrás de cada movimiento en la pista.
                </p>
            </div>

            <!-- Tarjeta 2: Sim Racing -->
            <div class="hobby-card w-[300px] sm:w-[350px] flex-shrink-0 bg-[#0a0a10]/60 backdrop-blur-xl border border-purple-500/30 shadow-[0_0_15px_rgba(168,85,247,0.1)] rounded-2xl p-5 group flex flex-col">
                <div class="w-full h-48 rounded-xl overflow-hidden relative border border-white/10 mb-4">
                    <Image src={simRacingImg} alt="Sim Racing" class="w-full h-full object-cover group-hover:scale-110 group-hover:-rotate-1 transition-all duration-500" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                </div>
                <h4 class="text-xl font-bold text-purple-400 mb-2">Sim Racing</h4>
                <p class="text-gray-400 text-sm leading-relaxed">
                    Juego a videojuegos que simulan las fisicas de un auto de carreras, ajustando setups para trail braking agresivo y dominando el force feedback con un volante G923 y pedales load-cell SIMSONN.
                </p>
            </div>

            <!-- Tarjeta 3: Mis perritos -->
            <div class="hobby-card w-[300px] sm:w-[350px] flex-shrink-0 bg-[#0a0a10]/60 backdrop-blur-xl border border-blue-500/30 shadow-[0_0_15px_rgba(59,130,246,0.1)] rounded-2xl p-5 group flex flex-col">
                <div class="w-full h-48 rounded-xl overflow-hidden relative border border-white/10 mb-4">
                    <Image src={bubusImg} alt="Mis perritos Yogui y Bubu" class="w-full h-full object-cover group-hover:scale-110 group-hover:rotate-1 transition-all duration-500" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                </div>
                <h4 class="text-xl font-bold text-blue-400 mb-2">Mis perritos</h4>
                <p class="text-gray-400 text-sm leading-relaxed">
                    Disfruto de la compañía de mis perritos, que son una gran fuente de alegría y entretenimiento en mi vida diaria. Se llaman Yogui y Bubu. Me encanta pasar tiempo con ellos, jugar y cuidarlos, lo que me brinda momentos de felicidad y relajación.
                    Mejor conocidos como el "Bubulubu combo" por su inseparable hermandad y travesuras.
                </p>
            </div>

        </div>
    </div>

    <!-- Controles del Carrusel -->
    <div class="flex justify-center gap-6 mt-8">
        <button id="btn-prev" class="w-12 h-12 flex items-center justify-center rounded-full bg-white/5 border border-cyan-500/50 text-cyan-400 hover:bg-cyan-500/20 hover:shadow-[0_0_10px_rgba(34,211,238,0.5)] backdrop-blur-md transition-all cursor-pointer">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <button id="btn-next" class="w-12 h-12 flex items-center justify-center rounded-full bg-white/5 border border-purple-500/50 text-purple-400 hover:bg-purple-500/20 hover:shadow-[0_0_10px_rgba(168,85,247,0.5)] backdrop-blur-md transition-all cursor-pointer">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
    </div>
</section>

<script>
    import { gsap } from "gsap";

    // Astro ejecuta los scripts del lado del cliente de forma optimizada
    document.addEventListener('DOMContentLoaded', () => {
        const track = document.getElementById('hobbies-track');
        const cards = document.querySelectorAll('.hobby-card');
        const btnPrev = document.getElementById('btn-prev');
        const btnNext = document.getElementById('btn-next');

        if (!track || cards.length === 0) return;

        let currentIndex = 0;
        // Calculamos el ancho de la tarjeta + el gap (gap-6 de Tailwind = 24px)
        const getCardWidth = () => cards[0].getBoundingClientRect().width + 24; 
        
        // Animación de entrada estilo Cyberpunk (Aparecen desde abajo con un fade)
        gsap.from(cards, {
            y: 50,
            opacity: 0,
            duration: 0.8,
            stagger: 0.2,
            ease: "power3.out",
            delay: 0.2 // Pequeño retraso para que cargue la vista
        });

        // Función para mover el carrusel
        const moveCarousel = () => {
            const width = getCardWidth();
            gsap.to(track, {
                x: -(currentIndex * width),
                duration: 0.6,
                ease: "power4.out" // Movimiento rápido que desacelera suavemente
            });
        };

        // Lógica de botones
        btnNext?.addEventListener('click', () => {
            // Permitimos avanzar siempre que no estemos en la última tarjeta
            if (currentIndex < cards.length - 1) {
                currentIndex++;
                moveCarousel();
            } else {
                // Efecto de "rebote" si intentan avanzar al final
                gsap.to(track, { x: -(currentIndex * getCardWidth()) - 20, yoyo: true, repeat: 1, duration: 0.2 });
            }
        });

        btnPrev?.addEventListener('click', () => {
            if (currentIndex > 0) {
                currentIndex--;
                moveCarousel();
            } else {
                // Efecto de "rebote" al inicio
                gsap.to(track, { x: 20, yoyo: true, repeat: 1, duration: 0.2 });
            }
        });

        // Recalcular posiciones si la pantalla cambia de tamaño
        window.addEventListener('resize', moveCarousel);
    });
</script>