<section id="about" class="w-full max-w-5xl mx-auto py-16 px-6 relative z-10">
    
    <div class="flex items-center gap-4 mb-10 border-l-4 border-purple-500 pl-4">
        <h3 class="text-3xl font-bold text-cyan-400 drop-shadow-[0_0_8px_rgba(34,211,238,0.5)]">
            Formación Académica
        </h3>
    </div>

    <div class="bg-[#0a0a10]/60 backdrop-blur-xl border border-cyan-500/30 shadow-[0_0_20px_rgba(0,150,255,0.1)] rounded-2xl p-8">
        <div class="text-gray-300">
            <p class="text-xl font-semibold">Ingeniería en Sistemas Computacionales</p>
            <p class="text-purple-300 mt-1">Instituto Politécnico Nacional (IPN)</p>
        </div>
        <div class="text-gray-300 mt-5">
            <p class="text-xl font-semibold">Técnico en computación</p>
            <p class="text-purple-300 mt-1">CECyT 8 "Narciso Bassols" (IPN)</p>
