---
import { Image } from 'astro:assets';
import logo from '../assets/logo_danmg_sf.webp';
---

<header class="fixed top-6 left-0 w-full flex items-center px-8 z-50">
    
    <!-- 1. Logo independiente a la izquierda -->
    <a href="/" class="hover:scale-105 transition-transform duration-300 relative z-20 flex-shrink-0">
        <Image src={logo} alt="Logo de Danmg" class="h-14 w-auto object-contain drop-shadow-[0_0_12px_rgba(0,123,255,0.8)]" />
    </a>

    <!-- 2. Contenedor invisible estrictamente para centrar -->
    <div class="absolute left-1/2 -translate-x-1/2 w-max">
        
        <!-- 3. Navegación visual (Ahora solo usa "relative" y abraza el texto) -->
        <nav class="relative bg-[#0a0a10]/60 backdrop-blur-xl border border-cyan-500/30 shadow-[0_0_20px_rgba(0,150,255,0.15)] rounded-full px-10 py-3 flex items-center justify-center overflow-hidden group">
            
            <!-- Brillo dinámico de fondo -->
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-cyan-400/10 to-transparent -translate-x-full group-hover:animate-[shimmer_2s_infinite] pointer-events-none"></div>

            <!-- Aseguramos que la lista no tenga márgenes extra (m-0 p-0) y justificamos al centro -->
            <ul class="flex items-center justify-center gap-10 font-medium text-gray-400 relative z-10 text-sm tracking-wider m-0 p-0">
                <li>
                    <a href="/" class="hover:text-cyan-400 hover:drop-shadow-[0_0_8px_rgba(34,211,238,0.9)] transition-all duration-300">Inicio</a>
                </li>
                <li>
                    <a href="#about" class="hover:text-cyan-400 hover:drop-shadow-[0_0_8px_rgba(34,211,238,0.9)] transition-all duration-300">Sobre mí</a>
                </li>
                <li>
                    <a href="#contact" class="hover:text-cyan-400 hover:drop-shadow-[0_0_8px_rgba(34,211,238,0.9)] transition-all duration-300">Redes</a>
                </li>
            </ul>
        </nav>
        
    </div>

</header>